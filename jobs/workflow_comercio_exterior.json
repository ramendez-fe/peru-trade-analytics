{
  "name": "pipeline_comercio_exterior_mvp",
  "email_notifications": {
    "on_failure": [
      "ramendez.fe@gmail.com"
    ]
  },
  "webhook_notifications": {},
  "timeout_seconds": 0,
  "schedule": {
    "quartz_cron_expression": "0 0 6 * * ?",
    "timezone_id": "America/Lima",
    "pause_status": "UNPAUSED"
  },
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "ingesta_bronze",
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/peru-trade-analytics/bronze/04_escritura_bronze",
        "source": "WORKSPACE"
      },
      "max_retries": 2,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": false,
      "timeout_seconds": 0,
      "email_notifications": {},
      "disabled": false
    },
    {
      "task_key": "silver_limpieza",
      "depends_on": [
        {
          "task_key": "ingesta_bronze"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/peru-trade-analytics/silver/01_limpieza_conciliacion",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "disabled": false
    },
    {
      "task_key": "silver_moneda",
      "depends_on": [
        {
          "task_key": "silver_limpieza"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/peru-trade-analytics/silver/02_conversion_moneda",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "disabled": false
    },
    {
      "task_key": "gold_hechos",
      "depends_on": [
        {
          "task_key": "silver_moneda"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/peru-trade-analytics/gold/04_hechos_exportaciones",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "disabled": false
    }
  ],
  "queue": {
    "enabled": true
  }
}